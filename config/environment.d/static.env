# Static (deployment-independent) variables for /etc/environment.
# SINGLE SOURCE OF TRUTH — consumed by:
#   - Dockerfile (baseline /etc/environment baked into the image, for
#     the case where a non-default entrypoint skips regeneration)
#   - entrypoint stage 60-environment.sh (prepended verbatim on every
#     boot before the compose passthrough vars)
# pam_env syntax: KEY="value", no `export`.
PATH="/home/claude/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
DOCKER_HOST="tcp://localhost:2375"
DISPLAY=":99"
